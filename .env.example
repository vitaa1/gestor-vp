# Banco local utilizado pelo Docker Compose
POSTGRES_DB=vence_facil
POSTGRES_USER=vence_facil
POSTGRES_PASSWORD=vence_facil_local
POSTGRES_PORT=5432

# API Spring Boot
DB_URL=jdbc:postgresql://localhost:5432/vence_facil
DB_USERNAME=vence_facil
DB_PASSWORD=vence_facil_local
SPRING_FLYWAY_URL=jdbc:postgresql://localhost:5432/vence_facil
SPRING_FLYWAY_USER=vence_facil
SPRING_FLYWAY_PASSWORD=vence_facil_local
SERVER_PORT=8080
APP_PORT=8080
APP_USERNAME=operador
APP_PASSWORD=troque-esta-senha-local

# Proteção de autenticação
AUTH_RATE_LIMIT_MAX_FAILURES=5
AUTH_RATE_LIMIT_MAX_FAILURES_PER_IP=20
AUTH_RATE_LIMIT_WINDOW=15m
AUTH_RATE_LIMIT_MAX_KEYS=10000
TRUSTED_PROXY_HEADER=

# Use somente em um banco exclusivo, vazio e descartável de demonstração
DEMO_MODE=false
DEMO_INSTANCE_ID=
DEMO_RESET_AFTER=24h
