# Banco local utilizado pelo Docker Compose
POSTGRES_DB=gestor_vp
POSTGRES_USER=gestor_vp
POSTGRES_PASSWORD=gestor_vp_local
POSTGRES_PORT=5432

# API Spring Boot
DB_URL=jdbc:postgresql://localhost:5432/gestor_vp
DB_USERNAME=gestor_vp
DB_PASSWORD=gestor_vp_local
DB_PREPARE_THRESHOLD=0
SPRING_FLYWAY_URL=jdbc:postgresql://localhost:5432/gestor_vp
SPRING_FLYWAY_USER=gestor_vp
SPRING_FLYWAY_PASSWORD=gestor_vp_local
SERVER_PORT=8080
APP_PORT=8080
APP_USERNAME=operador
APP_PASSWORD=troque-esta-senha-local
APP_DEFAULT_TIME_ZONE=America/Sao_Paulo

# Proteção de autenticação
AUTH_RATE_LIMIT_MAX_FAILURES=5
AUTH_RATE_LIMIT_MAX_FAILURES_PER_IP=20
AUTH_RATE_LIMIT_WINDOW=15m
AUTH_RATE_LIMIT_MAX_KEYS=10000
TRUSTED_PROXY_HEADER=

# Use somente em um banco exclusivo, vazio e descartável de demonstração
DEMO_MODE=false
DEMO_INSTANCE_ID=
DEMO_RESET_AFTER=24h
